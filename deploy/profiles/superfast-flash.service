[Unit]
Description=SUPERFAST flash profile (Qwen3.8-Flash-Next MoE, port 8731)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=__XDG__
ExecStartPre=-/usr/bin/podman rm -f superfast-flash
# The engine reads HALOGEN_* names. SUPERFAST_* appears nowhere in either
# image, so a setting written under that name is accepted by nobody and
# silently does nothing (verified by searching both images for the string).
#
# These six values are one budget, and they are what lets several agent
# conversations stay resident instead of re-prefilling their whole history:
#   KV_SLOTS x CTX     what one request may use, 4 x 262144.
#   KV_POOL_POSITIONS  positions resident across ALL conversations. 655360 is
#                      two and a half full-length conversations, or three of the
#                      ~150K ones an agent actually carries; each request
#                      reserves prompt + max_tokens of it. It was 786432 until
#                      2026-10-11: see "WHY 655360 AND NOT 786432" below.
#   KV_POOL_FIT=0      do not shrink the pool at startup. Left at its default
#                      the engine fitted a request for 1048576 back down to
#                      524288, so the setting had no effect at all.
#   MAX_TOK=16384      the single-call prefill arena. This pool only fits with
#                      the arena halved; longer prompts are prefilled in
#                      arena-sized pieces, which is what makes a large context
#                      affordable in the first place.
#   CACHE_ENTRIES=32   how many conversations keep their resumable state. The
#                      image ships 8. 32 keeps ~6 conversations resident, so
#                      resuming one after a pause hits warm rather than
#                      re-prefilling its whole history. Each entry costs ~111
#                      MiB, so 32 is ~3.5 GiB where 64 would be ~7.2 GiB: it was
#                      64 until 2026-10-11, when the host's headroom was measured
#                      and 7.2 GiB turned out to be too much of it. The cache is
#                      LRU, never time-expiring: a resume is slow only when its
#                      entry was evicted by capacity (other conversations or
#                      subagents), which is what this count trades against memory.
#                      Raise it only if the machine has room to give.
#
# WHY 786432 AND NOT 1048576, measured 2026-09-13: with 1048576 and FIT=0 the
# engine no longer starts on a host that has been running for a while. It
# reaches "model ready", prints "reserving 3 more serving slot(s)", and then
# spins at 80-90% of a core forever without listening — three attempts, no
# error, and `Restart=on-failure` cannot help because the process never exits.
# The startup log says why: after reserving the pool, only ~140-312 MiB of the
# engine's contiguous 2 MiB blocks are left, and the three remaining slots want
# ~333 MiB (4 x 111 MiB). 786432 starts and serves, repeatedly, and it is sized
# for what agents carry: four clients at 163,199 tokens each (656K positions of
# reservations, four clients against four slots, so only the pool can matter)
# measured 57.7 t/s aggregate with a warm cache against 15.5 t/s on a fitted
# 524288 pool — which could not hold the four conversations and re-prefilled two
# of them from zero. Once the pool IS exhausted its size stops mattering: with
# eight clients, over both pools at once, 33.8 against 35.5 t/s, because the
# slots decide there. No pool size protects against the host, either — the same
# unit loaded and then wedged while serving after many container starts in one
# night, and the container's own watchdog killed it at 180 s. A reboot clears
# that state. The measurements are in the README under "Many agents at once".
#
# WHY 655360 AND NOT 786432, measured 2026-10-11: the pool is the only term of
# the engine's footprint a host can give back (the 68.0 GiB of pinned weights
# and the 12.3 GiB of working memory are not adjustable), and at 786432 the
# engine left the host about 13 GiB to live on. That was enough on a freshly
# booted machine and not enough after a few hours of use: once the page cache
# and the zram swap had filled, the pool reservation consumed the last of the
# contiguous 2 MiB blocks the engine allocates from — 59 to 80 of them left
# (120-160 MiB) — and the engine then stalled for minutes at a time while a
# request was in flight. The container's own 180 s watchdog does not distinguish
# that stall from a dead engine, so it killed it and systemd restarted it: 28
# kills and 33 starts in one day, each restart beginning with less room than the
# one before. Same machine, measured after the change: footprint 101.8 -> 98.2
# GiB, contiguous blocks left after the pool reservation 5559-5604 (11.1 GiB) ->
# 8442 (16.5 GiB), memory left for everything else 13.5 -> 16.9 GiB, and a chat
# answered in 1.3 s. The cache allowance is the second lever, and it is set to 32
# for the same reason: each entry is 111 MiB, so 32 rather than 64 keeps 3.6 GiB
# free under load, at the cost of holding half as many conversations resident.
# tools/superfast-recover.sh hands the blocks back without a reboot.
#
# The last two are the request policy, and they are explicit for the same
# reason: they are what stops a long turn from being refused or cut, and the
# image defaults are not ours to rely on. QUEUE_TIMEOUT 3600 s is the time a
# request waits for room in the pool before the engine answers 503; the longest
# wait estimated here for four concurrent requests is 2,386 s, and a 503 would
# waste all of it. MAX_TOKENS_CAP 65536 is the largest answer budget
# a request may ask for, and it matches what the image ships; above it the
# engine answers 400 rather than truncating. "Timeouts, and why they are what
# they are" in the README derives the client-side values from this timeout.
ExecStart=/usr/bin/podman run --name superfast-flash --rm -p 127.0.0.1:8731:8731 \
  --device /dev/kfd --device /dev/dri --group-add keep-groups \
  --security-opt seccomp=unconfined --ipc=host \
  -e HALOGEN_KV_SLOTS=4 \
  -e HALOGEN_CTX=262144 \
  -e HALOGEN_KV_POOL_POSITIONS=655360 \
  -e HALOGEN_KV_POOL_FIT=0 \
  -e HALOGEN_MAX_TOK=16384 \
  -e HALOGEN_CACHE_ENTRIES=32 \
  -e HALOGEN_QUEUE_TIMEOUT=3600 \
  -e HALOGEN_MAX_TOKENS_CAP=65536 \
  -v __FLASH_DIR__:/models:ro \
  -v __FLASH_DIR__/tokenizer:/tokenizer:ro \
  __FLASH_IMAGE__
ExecStop=/usr/bin/podman stop -t 30 superfast-flash
# `podman run` in the foreground exits 143 (SIGTERM) or 137 (SIGKILL) when the
# container is stopped. Without this, a normal profile switch leaves the unit
# in the "failed" state and `superfast-switch status` reports it as failed.
SuccessExitStatus=137 143
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target

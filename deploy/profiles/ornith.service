[Unit]
Description=SUPERFAST ornith profile (Ornith-1.5-35B-A3B ROCmFP4, port 8731)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=__XDG__
ExecStartPre=-/usr/bin/podman rm -f ornith-server
ExecStart=/usr/bin/podman run --name ornith-server --rm -p 127.0.0.1:8731:8731 \
  --device /dev/kfd --device /dev/dri --group-add keep-groups \
  --security-opt seccomp=unconfined --ipc=host \
  -v __ORNITH_DIR__:/models:ro \
  -e GGML_VK_CONCAT_TRANSPOSE=1 \
  localhost/superfast-vk:patch0012 \
  -m /models/Ornith-1.5-35B-A3B-ROCmFP4.gguf \
  --host 0.0.0.0 --port 8731 \
  -c 262144 --alias ornith-1.5-35b-a3b --jinja \
  --parallel 1 --reasoning on --timeout 0
# The MTP head is inside the weights file (a nextn block), and the model card
# measures ~101 tok/s with it, but on this runtime it is a net loss and the
# flags are deliberately absent: measured 2026-11-12 on the same image and the
# same prompt, the pair
#   --spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0.6
# costs 16% of prefill (1,036 against 1,241 tok/s at 9,916 tokens) and returns
# about 3% of decode (75.1 against 73.2 tok/s), which is noise. --spec-draft-n-max 1
# does not change it (1,049 / 77.0). Re-add the pair only with a decode number
# that pays for the prefill, and record it in the README.
#
# --timeout is llama.cpp's socket read/write timeout, 600 s by default; 0 turns
# it off. A cold 262K prefill plus a long decode can outlast any fixed value,
# and the client and the gateway both bound the request themselves, so the
# reference machine runs without one.
ExecStop=/usr/bin/podman stop -t 30 ornith-server
# podman run exits 143/137 when the container is stopped: accept those, so a
# profile switch does not leave the unit in the "failed" state.
SuccessExitStatus=137 143
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target

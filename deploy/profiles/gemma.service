[Unit]
Description=SUPERFAST gemma profile (Gemma-4-26B-A4B ROCmFP4, port 8731)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=__XDG__
ExecStartPre=-/usr/bin/podman rm -f gemma-server
ExecStart=/usr/bin/podman run --name gemma-server --rm -p 127.0.0.1:8731:8731 \
  --device /dev/kfd --device /dev/dri --group-add keep-groups \
  --security-opt seccomp=unconfined --ipc=host \
  -v __GEMMA_DIR__:/models:ro \
  llama-rocmfpx:7.2.4 \
  -m /models/gemma-4-26B-A4B-it-Q4_0_ROCMFP4_COHERENT.gguf \
  --host 0.0.0.0 --port 8731 \
  -c 262144 --alias gemma-4-26b-a4b --jinja \
  --parallel 1 --timeout 0
# --parallel 1 is one slot, so requests queue instead of sharing the window.
# --timeout is llama.cpp's socket read/write timeout, 600 s by default; 0 turns
# it off, as on the reference machine: the server sends nothing while it
# prefills a 229,376-token prompt and closes idle connections between turns,
# so a fixed value is a silent cut. The client values that go with it are in
# the README under "Timeouts, and why they are what they are".
ExecStop=/usr/bin/podman stop -t 30 gemma-server
# podman run exits 143/137 when the container is stopped: accept those, so a
# profile switch does not leave the unit in the "failed" state.
SuccessExitStatus=137 143
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
